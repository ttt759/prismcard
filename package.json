{
  "name": "prismcard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && npm run build:skill",
    "build:skill": "node scripts/build-skill.mjs",
    "build:docs": "node scripts/build-docs-assets.mjs",
    "preview": "vite preview",
    "test": "tsx --test tests/parser.test.ts",
    "test:browser": "node --test tests/browser.test.mjs",
    "render": "node skills/prismcard/scripts/render-cards.mjs"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.1.1",
    "markdown-it-mark": "^4.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "playwright-core": "1.61.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.8"
  }
}
